# Proxmox LXC bootstrap defaults

CORES=2
MEMORY_MB=2048
SWAP_MB=512
DISK_GB=20

# Proxmox storage names.
# Leave empty to automatically select an active template storage and to ask
# for the LXC rootfs storage when multiple choices exist.
TEMPLATE_STORAGE=
ROOTFS_STORAGE=

# Network
# Leave BRIDGE empty to auto-select when there is one bridge, or to show an
# interactive choice when multiple bridges are available.
BRIDGE=
IP_CONFIG=dhcp
# Example static configuration:
# IP_CONFIG=192.168.95.220/24
# GATEWAY=192.168.95.1
GATEWAY=

# Debian template family; newest matching template for the Proxmox host
# architecture is selected automatically.
TEMPLATE_PATTERN=debian-13-standard_

# Container defaults
UNPRIVILEGED=1
ONBOOT=1
FEATURES=nesting=1,keyctl=1
