# Proxmox LXC bootstrap defaults

CORES=2
MEMORY_MB=2048
SWAP_MB=512
DISK_GB=20

# Proxmox storage names.
# Leave empty to automatically select an active storage that supports the
# required content type (vztmpl for templates, rootdir for LXC disks).
TEMPLATE_STORAGE=
ROOTFS_STORAGE=

# Network
BRIDGE=vmbr0
IP_CONFIG=dhcp
# Example static configuration:
# IP_CONFIG=192.168.95.220/24
# GATEWAY=192.168.95.1
GATEWAY=

# Debian template family; newest matching template is selected automatically.
TEMPLATE_PATTERN=debian-13-standard_

# Container defaults
UNPRIVILEGED=1
ONBOOT=1
FEATURES=nesting=1,keyctl=1
